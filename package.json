{
  "name": "panthr",
  "productName": "Panthr",
  "version": "1.1.0",
  "description": "Make videos by talking to an agent, on your Mac.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build -c vite.server.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && vite build -c vite.server.config.ts && electron-builder --mac --dir",
    "build:ocr": "swiftc -O -target arm64-apple-macos13 build/ocr.swift -o resources/bin/panthr-ocr",
    "sign:local": "sh scripts/sign-local.sh",
    "build:capture": "swiftc -O -target arm64-apple-macos14 build/capture.swift -o resources/bin/panthr-capture",
    "build:input": "swiftc -O -target arm64-apple-macos13 build/input.swift -o resources/bin/panthr-input",
    "dist:mas": "electron-vite build && electron-builder --mac mas --arm64 -c.appId=io.clueso.lightbox"
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.clueso.panthr",
    "productName": "Panthr",
    "copyright": "Panthr by Clueso",
    "fileAssociations": [
      {
        "ext": "panthr",
        "name": "Panthr project",
        "description": "A Panthr project: its videos, canvas, notes and brand kit",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dir"
      ],
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Panthr records your voice with a screen recording, when you turn the microphone on.",
        "NSScreenCaptureUsageDescription": "Panthr records your screen when you ask it to, to make demo videos."
      }
    },
    "asar": true,
    "mas": {
      "target": [
        "mas"
      ],
      "identity": null,
      "type": "distribution",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "category": "public.app-category.video",
      "extendInfo": {
        "ElectronTeamID": "MD9W6ZH26S",
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  },
  "bin": {
    "panthr": "resources/cli/panthr.mjs"
  },
  "license": "MIT"
}